#!/usr/bin/env bash
# pre-push: dogany repo secret gate (DGN-668).
# secret-sweep (full cats 1-10; a valid .dogany-private-backup marker reduces
# the sweep to cats 1,6,7,8 -- owner-PII cats 2,3,4,5,9,10 skipped, DGN-808 /
# cat10 DGN-1696; the reduction is PRINTED on every push, never silent --
# DGN-1058) + D7 outbound-diff gate (dec-026).
#
# WHAT is swept (DGN-1696): the COMMITTED tree of every local sha being
# pushed (secret-sweep.sh --ref <sha>), read from git objects -- never the
# dirty working tree. An uncommitted memory write must not block the push of
# clean commits, and an uncommitted marker / .sweepignore cannot exempt one.
#
# This is the tracked canonical source. It is ACTIVE because the repo sets
# core.hooksPath=git-hooks (mint.sh / repo setup); .git/hooks/ is fully
# overridden by that config and never consulted, so per-clone hand-installed
# hooks are inert -- only this tracked file runs.
#
# SINGLE VARIANT (DGN-1058): git-hooks/pre-push and
# agents/.template/git-hooks/pre-push are byte-identical. There used to be two
# variants (root fail-open / template fail-closed on missing sweep), but
# update.sh section 3k1 delivers the ROOT copy into live instances -- so
# instances silently received the fail-open variant, contradicting the
# fail-closed declaration. The missing-sweep policy is now decided at RUNTIME
# from the repo's own content (see below), so no delivery path can ship the
# "wrong" variant.
#
# SWEEP path resolution (DGN-668):
#   1. DOGANY_SWEEP_SCRIPT env var (portable override; set on workspace move)
#   2. <repo-root>/scripts/secret-sweep.sh (instance-relative fallback,
#      derived from the repo this hook runs in via git rev-parse
#      --show-toplevel, with the hook's own location as a last resort --
#      never a hardcoded workspace path)
#
# Missing sweep script policy (runtime decision, DGN-960 B5 + DGN-1058):
#   - PII-bearing repo (live agent instance: root AGENT.md / USER.md /
#     identity/ / memories/ present) -> FAIL CLOSED. Instance repos carry real owner PII
#     and must never push ungated.
#   - Non-PII repo (canonical dev checkout, public framework clone -- neither
#     carries instance identity files at the root) -> fail-open with a printed
#     note. The public export STRIPS scripts/secret-sweep.sh (DGN-960), so a
#     public clone structurally lacks the sweep; blocking every push there
#     would be a dev-setup wall, not a PII gate.

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(git rev-parse --show-toplevel 2>/dev/null || dirname "$HOOK_DIR")"
SWEEP="${DOGANY_SWEEP_SCRIPT:-$REPO_DIR/scripts/secret-sweep.sh}"

if [ ! -x "$SWEEP" ]; then
  # Detect a PII-bearing repo by its instance identity surfaces. Broad OR on
  # purpose: ANY of these present -> treat as instance -> fail closed. The
  # safe failure direction is CLOSED, so detection over-triggering only ever
  # blocks a push, never opens the gate.
  if [ -e "$REPO_DIR/AGENT.md" ] || [ -e "$REPO_DIR/USER.md" ] \
     || [ -d "$REPO_DIR/identity" ] || [ -d "$REPO_DIR/memories" ]; then
    echo "PUSH BLOCKED -- secret-sweep.sh not found or not executable: $SWEEP" >&2
    echo "(fail-closed gate: this repo carries instance identity/PII surfaces." >&2
    echo " Set DOGANY_SWEEP_SCRIPT to the sweep script path, or place it at" >&2
    echo " <repo>/scripts/secret-sweep.sh; DGN-668 / DGN-1058)" >&2
    exit 1
  fi
  # DGN-960 B5: non-instance repo (canonical checkout / public clone) without
  # the sweep is a dev-setup gap, not a PII push risk. Fail-open + note.
  echo "[pre-push] NOTE: secret-sweep.sh not found at $SWEEP" >&2
  echo "[pre-push] Skipping secret sweep (non-instance repo without sweep script -- fail-open)." >&2
  echo "[pre-push] Install secret-sweep.sh or set DOGANY_SWEEP_SCRIPT to enable the PII gate." >&2
  exit 0
fi

# ---- pre-push stdin (read ONCE, consumed by both gates below) ---------------
# protocol: <local-ref> <local-sha> <remote-ref> <remote-sha>, one line per ref.
# DGN-1696: every non-delete local sha is swept (deduped). No usable line
# (manual hook run) -> sweep HEAD, never nothing.
# D7: the remote SHA is the base-ref when non-zero; fall back to origin/main.
ZERO_SHA="0000000000000000000000000000000000000000"
PUSH_SHAS=""
PUSH_RANGES=""   # "<local-sha>:<remote-sha>" per non-delete ref (DGN-1724)
BASE_REF=""
TAG_PUSH=""      # DGN-1734: a refs/tags/v* ref in this push -> full lane=all
TAG_STABLE=""    # DGN-1765: ... that is NOT a dev tag -> lane=all
TAG_DEV_SHA=""   # DGN-1765: commit a vX.Y.Z-dev.N tag peels to -> lane=devtag
TAG_STABLE_SHA="" # DGN-1878: commit the stable tag peels to -> lane=stable may reuse
TAG_STABLE_BAD="" # ... unpeelable / two commits / forced by a bad dev tag -> no reuse
_PP_LINES=0      # DGN-1921: total ref lines seen on stdin
_PP_DELETES=0    # DGN-1921: of those, how many are ref deletes (local sha all-zero)
DEV_PUSH_SHA=""  # DGN-1948: commit this push sends to refs/heads/dev (non-delete)
while read -r local_ref local_sha remote_ref remote_sha; do
  _PP_LINES=$((_PP_LINES + 1))
  [ "$local_sha" = "$ZERO_SHA" ] && _PP_DELETES=$((_PP_DELETES + 1))
  if [ -n "$local_sha" ] && [ "$local_sha" != "$ZERO_SHA" ]; then
    case "$local_ref $remote_ref" in
      refs/tags/v*|*" refs/tags/v"*)
        TAG_PUSH="${remote_ref:-$local_ref}"
        case "$TAG_PUSH" in
          refs/tags/v[0-9]*-dev.[0-9]*)
            # unpeelable, or two dev tags on different commits -> full lane
            _peel="$(git -C "$REPO_DIR" rev-parse --verify -q "$local_sha^{commit}" 2>/dev/null)"
            if [ -z "$_peel" ] || { [ -n "$TAG_DEV_SHA" ] && [ "$TAG_DEV_SHA" != "$_peel" ]; }; then
              TAG_STABLE="$TAG_PUSH"; TAG_STABLE_BAD=1
            else
              TAG_DEV_SHA="$_peel"
            fi
            ;;
          *)
            TAG_STABLE="$TAG_PUSH"
            _peel="$(git -C "$REPO_DIR" rev-parse --verify -q "$local_sha^{commit}" 2>/dev/null)"
            if [ -z "$_peel" ] || { [ -n "$TAG_STABLE_SHA" ] && [ "$TAG_STABLE_SHA" != "$_peel" ]; }; then
              TAG_STABLE_BAD=1
            else
              TAG_STABLE_SHA="$_peel"
            fi
            ;;
        esac
        ;;
    esac
    case "$PUSH_SHAS" in
      *"$local_sha"*) : ;;
      *) PUSH_SHAS="${PUSH_SHAS}${local_sha} " ;;
    esac
    PUSH_RANGES="${PUSH_RANGES}${local_sha}:${remote_sha:-$ZERO_SHA} "
    [ "$remote_ref" = "refs/heads/dev" ] && DEV_PUSH_SHA="$local_sha"
  fi
  if [ -n "$remote_sha" ] && [ "$remote_sha" != "$ZERO_SHA" ]; then
    BASE_REF="$remote_sha"
  fi
done

# DGN-1921: a delete-only push (every line's local sha is all-zero) carries no
# code -- there is nothing for the secret sweep, D7, the machine-line-gate
# lint or the estate test lane to examine, and sweeping HEAD as a stand-in
# (the "no usable line" fallback below) was wrong here: it swept committed
# code the push never touches and paid the full fast lane (DGN-1211) just to
# delete a ref. Exit before any lane runs. This never widens what a delete is
# allowed to do: no rule in this hook refuses deleting main/dev/a v* tag
# today (that case-statement above only ever fires for a NON-delete local
# sha), so there is no existing refusal to bypass. If one is added later, add
# it before this early exit so it still applies to delete-only pushes.
if [ "$_PP_LINES" -gt 0 ] && [ "$_PP_DELETES" -eq "$_PP_LINES" ]; then
  echo "[pre-push] delete-only push: no test lane" >&2
  exit 0
fi

[ -n "$PUSH_SHAS" ] || PUSH_SHAS="HEAD"
if [ -z "$BASE_REF" ]; then
  BASE_REF="origin/main"
fi

# ---- secret-sweep (full, or DGN-808 reduced -- reduction always printed) ----
for _push_sha in $PUSH_SHAS; do
  SWEEP_EXIT=0
  SWEEP_OUT="$("$SWEEP" --ref "$_push_sha" "$REPO_DIR" 2>&1)" || SWEEP_EXIT=$?
  # Version skew (hook delivered before the sweep learned --ref): run the
  # pre-DGN-1696 working-tree sweep -- the previous gate, never no gate --
  # and say so loudly.
  if [ "$SWEEP_EXIT" -eq 2 ] && printf '%s\n' "$SWEEP_OUT" | grep -q '^unknown flag: --ref'; then
    echo "[pre-push] NOTE: $SWEEP predates --ref (DGN-1696); sweeping the WORKING TREE instead of the pushed commit" >&2
    SWEEP_EXIT=0
    SWEEP_OUT="$("$SWEEP" "$REPO_DIR" 2>&1)" || SWEEP_EXIT=$?
  fi
  if [ "$SWEEP_EXIT" -ne 0 ]; then
    echo "PUSH BLOCKED -- secret-sweep dirty (pushed commit $_push_sha):" >&2
    echo "$SWEEP_OUT" >&2
    exit 1
  fi
  # DGN-1058: never silent-pass. Surface the sweep scope on EVERY successful
  # push so "clean full sweep" and "clean reduced sweep" stay distinguishable
  # (a reduced sweep prints which categories were skipped on its RESULT line;
  # swallowing that on success would make reduction invisible -- the exact
  # quiet-failure class this gate exists to prevent). The mode= line carries
  # the swept commit (DGN-1696) so the scope says WHAT was swept.
  echo "$SWEEP_OUT" | grep -E '^note: private owner-backup|^  owner-PII cats|^secret-sweep :: repo=.* mode=|^RESULT:'
done

# ---- D7 outbound-diff gate (dec-026, 2026-07-16) ----------------------------

D7_EXIT=0
D7_OUT="$("$SWEEP" --outbound-diff "$BASE_REF" "$REPO_DIR" 2>&1)" || D7_EXIT=$?
if [ "$D7_EXIT" -ne 0 ]; then
  echo "PUSH BLOCKED (D7) -- outbound primitive added without review:" >&2
  echo "$D7_OUT" >&2
  exit 1
fi
# DGN-1613: never silent-pass D7 either -- surface its actual scope (and
# result) on every successful push, same direction as the sweep-scope print
# above. A passing D7 run must say what comparison it actually looked at, not
# just that it passed; the reviewed-hit bodies (if any) are deliberately NOT
# in this filter. A zero-match filter (e.g. an older DOGANY_SWEEP_SCRIPT
# override without these prefixes) is harmless and does not change this
# push's success.
printf '%s\n' "$D7_OUT" | grep -E '^(D7-SCOPE:|RESULT: D7-|D7-REVIEWED:)'

# ---- DGN-1209 machine-line gate wiring lint ---------------------------------
# "landed" means WIRED at the call site (DGN-1208), not "file exists". Every
# owner-facing render rail must DECLARE its rail into the ONE outbound gate
# (bridge/machine_gate.py); a rail that stops declaring re-opens the leak with
# zero runtime signal, and the bridge test suite has no runner (DGN-1211) --
# this hook is the reader that actually stops the regression.
# Scope: runs only where the gate itself is present (machine_gate.py). A
# bridge that predates the gate (pre-migration instance, DGN-1206) is noted
# and skipped -- the lint checks wiring of a landed gate, not migration state.
_MLG_BRIDGE=""
for _cand in "$REPO_DIR/agents/.template/bridge" "$REPO_DIR/bridge"; do
  if [ -f "$_cand/bot.py" ]; then _MLG_BRIDGE="$_cand"; break; fi
done
if [ -n "$_MLG_BRIDGE" ] && [ -f "$_MLG_BRIDGE/machine_gate.py" ]; then
  _mlg_fail=0
  _mlg_need() {  # <file> <fixed-string> <label>
    if ! grep -qF -- "$2" "$1" 2>/dev/null; then
      echo "PUSH BLOCKED (DGN-1209) -- machine-line gate wiring missing: $3" >&2
      echo "  $1 lacks: $2" >&2
      _mlg_fail=1
    fi
  }
  _mlg_need "$_MLG_BRIDGE/bot.py"        "content = apply_machine_line_gate(content, rail)"           "bot-side choke point (_render_prose_html_segments)"
  _mlg_need "$_MLG_BRIDGE/formatting.py" "text = apply_machine_line_gate(text, rail)"                 "formatting choke point (sanitize_message_for_telegram)"
  _mlg_need "$_MLG_BRIDGE/bot.py"        "text, rail=RAIL_CONSUMER"                                   "R1 idrill followup_cmd rail declaration"
  _mlg_need "$_MLG_BRIDGE/bot.py"        "force_options=has_options, rail=RAIL_CONSUMER"              "R2 fastpath body rail declaration"
  _mlg_need "$_MLG_BRIDGE/../routines/push.sh" "rail=machine_gate.RAIL_CONSUMER"                      "R3 push.sh --text rail declaration"
  _mlg_need "$_MLG_BRIDGE/dashboard.py"  "sanitize_message_for_telegram(text, rail=RAIL_CONSUMER)"    "R4 dashboard pin rail declaration"
  _mlg_need "$_MLG_BRIDGE/bot.py"        "self._render_prose_html_segments(content, rail=RAIL_MODEL)" "model reply body through the shared renderer"
  if [ "$_mlg_fail" -ne 0 ]; then
    exit 1
  fi
  echo "[pre-push] DGN-1209 machine-line gate wiring: OK (4 rails declared, 2 choke points)"
elif [ -n "$_MLG_BRIDGE" ]; then
  echo "[pre-push] NOTE: bridge predates the DGN-1209 machine-line gate (no machine_gate.py); wiring lint skipped" >&2
fi

# ---- estate test lane (DGN-1211) --------------------------------------------
# The harness carried NO test runner estate-wide: bridge pytest, pack tests
# and the tests/ lints all had zero readers (DGN-1209 grill / estate-wide reader census).
# run-tests.sh discovers this repo's test assets at runtime and enforces
# per-suite budgets, refuses quiet-green (all-skip / 0-collected passes block
# -- DGN-1154), and prints a RESULT line on every run including "0 assets
# found". Test failure / timeout -> push blocked; runner-runtime absence
# (python3/pytest) -> loud pass, printed as DEGRADED, never as PASS (same
# direction as the missing-sweep policy above).
# DGN-1263 widened discovery from the tests/*_lint.{py,sh} name glob (which
# left 29 selftest suites with zero readers) to every *.sh/*.py under tests/,
# each declaring its own lane. What runs HERE is the fast lane only.
# pre-push, not pre-commit, on measured evidence: bridge pytest ~25s
# (2026-09-03: canonical 26.7s / a live instance 24.5s) + the fast lane 41.5s
# (23 suites, measured same day; the 6 suites over 8s -- 339s together -- are
# the slow lane and run off the staleness clock, not on every push).
# DGN-1734: 214 fast suites later (651s measured) the push runs only the
# AFFECTED suites -- see "IMPACT SELECTION" in run-tests.sh.
# Push-cadence money, not commit-cadence money. pre-commit stays a pure
# git-topology guard.
# DGN-1696: an automated owner-data backup is data, not framework code.  The
# sweep above has already examined every pushed tree and remains mandatory;
# only the DGN-1211 test lane may be skipped.  Keep this independent copy of
# the sweep's declaration rule deliberately fail-closed: each pushed tree must
# carry a regular (not symlink) marker whose first non-comment line is exactly
# the declaration, and must not carry the public-export path.
_owner_backup_tree_declared() {  # $1 = pushed commit/tree-ish
  _ob_entry="$(git -C "$REPO_DIR" ls-tree --full-tree "$1" -- .dogany-private-backup 2>/dev/null)"
  case "$_ob_entry" in
    120000\ *) return 1 ;; # symlink: never a valid declaration
    *\ blob\ *) ;;
    *) return 1 ;;
  esac
  _ob_first="$(git -C "$REPO_DIR" show "$1:.dogany-private-backup" 2>/dev/null \
    | grep -vE '^[[:space:]]*(#|$)' 2>/dev/null | head -1 \
    | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [ "$_ob_first" = "declare: private-owner-backup" ] || return 1
  [ -z "$(git -C "$REPO_DIR" ls-tree --full-tree "$1" -- scripts/publish.sh 2>/dev/null)" ]
}

# DGN-1724: backup-only mode WITHOUT the marker. DGN-1696 required the
# .dogany-private-backup declaration, which ordinary instances never carry, so
# routines/backup-data.sh (which sets DOGANY_PUSH_PURPOSE=owner-backup) still
# ran the full test lane there: one unrelated red suite blocked every nightly
# backup push for a month. The second qualifying shape is structural: every
# commit this push would add to the remote is a non-merge commit that touches
# ONLY database/*.sql dump files (regular files or deletions). Such a push
# carries no code, so the test lane has nothing to verify; the secret sweep
# and D7 above have already run on it and still gate it. Anything else in the
# pushed range (a code commit, a merge, a symlink, a script under database/,
# an unresolvable remote sha) fails closed to the full lane.
_backup_range_data_only() {  # $1 = local sha, $2 = remote sha (or zeros)
  if [ "$2" != "$ZERO_SHA" ] && git -C "$REPO_DIR" cat-file -e "$2^{commit}" 2>/dev/null; then
    set -- "$1" "$2" "^$2"
  elif [ "$2" != "$ZERO_SHA" ]; then
    return 1  # remote tip unknown locally: cannot bound the range
  else
    set -- "$1" "$2" "--not --remotes=origin"
  fi
  # shellcheck disable=SC2086  # $3 is intentionally word-split
  _bd_commits="$(git -C "$REPO_DIR" rev-list "$1" $3 2>/dev/null)" || return 1
  # shellcheck disable=SC2086
  [ -z "$(git -C "$REPO_DIR" rev-list --merges "$1" $3 2>/dev/null)" ] || return 1
  for _bd_c in $_bd_commits; do
    _bd_bad="$(git -C "$REPO_DIR" diff-tree --root --no-commit-id -r --no-renames "$_bd_c" 2>/dev/null \
      | awk -F'\t' '{
          split($1, m, " "); path = $2
          if (path !~ /^database\/[^\/]+\.sql$/) { print path; next }
          if (m[2] != "100644" && m[2] != "000000") { print path; next }
        }')"
    [ -z "$_bd_bad" ] || return 1
  done
  return 0
}

OWNER_BACKUP_PUSH=0
OWNER_BACKUP_WHY=""
if [ "${DOGANY_PUSH_PURPOSE:-}" = "owner-backup" ]; then
  OWNER_BACKUP_PUSH=1
  OWNER_BACKUP_WHY="declared private-backup repo (DGN-1696)"
  for _push_sha in $PUSH_SHAS; do
    if ! _owner_backup_tree_declared "$_push_sha"; then
      OWNER_BACKUP_PUSH=0
      break
    fi
  done
  if [ "$OWNER_BACKUP_PUSH" = "0" ] && [ -n "$PUSH_RANGES" ]; then
    OWNER_BACKUP_PUSH=1
    OWNER_BACKUP_WHY="pushed range is database/*.sql dumps only (DGN-1724)"
    for _range in $PUSH_RANGES; do
      if ! _backup_range_data_only "${_range%%:*}" "${_range#*:}"; then
        OWNER_BACKUP_PUSH=0
        break
      fi
    done
  fi
  if [ "$OWNER_BACKUP_PUSH" = "0" ]; then
    echo "[pre-push] owner-backup purpose declared but push is not backup-only -- full test lane runs" >&2
  fi
fi

RUNNER="$HOOK_DIR/run-tests.sh"
# DGN-1734: impact selection. The runner gets the pushed ranges and runs only
# the suites they touch (lane=affected), falling back to the full fast lane
# whenever it cannot vouch for the selection, and by itself every 24h. A push
# carrying a v* tag is a release cut (release.sh gate 7 pushes through this
# hook), so its lane is forced here -- the release gate is structural, not an
# env var release.sh has to remember. An explicit DGN_TEST_LANE still wins on
# untagged pushes. DGN-1765 (dec-196): a STABLE tag (any v* that is not
# vX.Y.Z-dev.N, and any push carrying one) runs the full lane=all, in
# parallel; a push whose only tags are DEV tags runs lane=devtag, which reuses
# the last green full run (< 36h) and re-runs what changed since -- or refuses
# and runs lane=all itself (see RELEASE LANE SPEED in run-tests.sh).
# DGN-1878 (2.6.1): the stable tag goes to lane=stable, which reuses the last
# full run only when its tested tree IS the tag's tree (green, this machine,
# < 24h, runner + hook unchanged) and otherwise runs lane=all exactly as
# before. An unverifiable tag hands the runner no commit, so it never reuses.
_TEST_TAG_SHA=""
if [ -n "$TAG_STABLE" ]; then
  [ -n "$TAG_STABLE_BAD" ] && TAG_STABLE_SHA=""
  echo "[pre-push] tag push ($TAG_STABLE) -- stable tag: test lane forced to lane=stable (DGN-1878: reuse a green full run of the IDENTICAL tree, < 24h, this machine, runner + hook unchanged; else the full lane=all, DGN-1734 release gate)" >&2
  _TEST_LANE=stable
  _TEST_TAG_SHA="$TAG_STABLE_SHA"
elif [ -n "$TAG_PUSH" ]; then
  echo "[pre-push] tag push ($TAG_PUSH) -- dev tag: test lane forced to lane=devtag (DGN-1765: reuse the last green full run < 36h, else lane=all)" >&2
  _TEST_LANE=devtag
  _TEST_TAG_SHA="$TAG_DEV_SHA"
else
  _TEST_LANE="${DGN_TEST_LANE:-affected}"
fi
if [ "$OWNER_BACKUP_PUSH" = "1" ]; then
  echo "[pre-push] test lane SKIPPED: owner-data backup push, $OWNER_BACKUP_WHY; secret sweep + D7 still enforced" >&2
elif [ -x "$RUNNER" ]; then
  # DGN-1881: git exported GIT_DIR to this hook; from a linked worktree it is
  # an ABSOLUTE path into the canonical .git and every suite inherited it
  # (fixture git ops landed on the real repo + remote). The runner gets a git
  # env without the repo-locating vars and re-derives its root from cwd; it
  # drops them again itself and adds the push guard (run-tests.sh).
  if ! ( unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
               GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
         DGN_TEST_LANE="$_TEST_LANE" DGN_TEST_CHANGED_RANGES="$PUSH_RANGES" DGN_TEST_TAG_SHA="$_TEST_TAG_SHA" "$RUNNER" ); then
    echo "PUSH BLOCKED -- test lane failed (DGN-1211, see [run-tests] lines above)." >&2
    echo "Deliberate red push (triaged, conscious): git push --no-verify" >&2
    exit 1
  fi
else
  # Partial delivery (hook present, runner not yet) must not wall every push,
  # but it must never be silent either.
  echo "[pre-push] NOTE: git-hooks/run-tests.sh missing -- test lane NOT RUN (fail-open, loud; DGN-1211)" >&2
fi

# ---- dev push -> background full lane (DGN-1948) ----------------------------
# Every gate above passed, so this push is about to reach the remote. A push
# of refs/heads/dev hands the full lane (lane=all) to a DETACHED runner job
# that waits for this git push to exit and runs only if the remote accepted
# (its tracking ref moved to the sha); queueing, supersede and the record are
# at "dev push -> background full lane" in run-tests.sh. Not for: a tag push
# (the cut's own lane=devtag/stable is that push's verification), an
# owner-backup push, a remote that is not a configured name (no tracking ref
# to confirm acceptance by), or a local-path remote (test fixtures and
# scratch clones) unless DGN_DEV_PUSH_LANE=1. Off: DGN_DEV_PUSH_LANE=0 or
# git config dogany.devPushLane=false.
_PUSH_REMOTE="${1:-}"
_PUSH_URL="${2:-}"
_dev_push_lane_on() {
  [ -n "$DEV_PUSH_SHA" ] && [ -z "$TAG_PUSH" ] && [ "$OWNER_BACKUP_PUSH" != "1" ] || return 1
  [ -x "$RUNNER" ] && grep -q -- '--dev-push-lane' "$RUNNER" 2>/dev/null || return 1
  [ -n "$_PUSH_REMOTE" ] && git -C "$REPO_DIR" remote 2>/dev/null | grep -qxF -- "$_PUSH_REMOTE" || return 1
  case "${DGN_DEV_PUSH_LANE:-}" in
    0) return 1 ;;
    1) return 0 ;;
  esac
  [ "$(git -C "$REPO_DIR" config --bool --get dogany.devPushLane 2>/dev/null)" = false ] && return 1
  case "$_PUSH_URL" in
    file://*|/*|./*|../*|'') return 1 ;;
    *://*|*@*:*) return 0 ;;
  esac
  return 1
}
if _dev_push_lane_on; then
  _dp_pid="$PPID"
  ( cd "$REPO_DIR" || exit 0
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
          GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
    if command -v python3 >/dev/null 2>&1; then
      # own session: no terminal signal or hangup reaches the job
      python3 -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
        bash "$RUNNER" --dev-push-lane "$DEV_PUSH_SHA" "$_PUSH_REMOTE" "$_dp_pid"
    else
      exec nohup bash "$RUNNER" --dev-push-lane "$DEV_PUSH_SHA" "$_PUSH_REMOTE" "$_dp_pid"
    fi
  ) < /dev/null > /dev/null 2>&1 &
  echo "[pre-push] dev push: full test lane (lane=all) for ${DEV_PUSH_SHA:0:12} starts in the BACKGROUND once $_PUSH_REMOTE accepts it; a newer dev push supersedes it while queued (DGN-1948). Status: bash git-hooks/run-tests.sh --dev-push-status" >&2
fi

exit 0
