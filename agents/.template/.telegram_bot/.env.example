# .env.example -- MANUAL SETUP REFERENCE for agents/.template/.telegram_bot/.env
#
# This file documents the keys that the bridge reads. It is NOT consumed by
# mint.sh (which generates the .env from env_render). Use this as a reference
# if you are setting up an instance by hand rather than via the installer or
# `mint.sh --print-env`.
#
# Copy to .env and fill in your values.
# The bridge loads PROJECT_ROOT/.telegram_bot/.env first, then falls back to
# the package bridge/.env for shared defaults (CLAUDE_CLI_PATH, etc.).
# This instance .env only needs this agent's own bot token and any overrides.

TELEGRAM_BOT_TOKEN=<bot token from BotFather>

# ALLOWED_USER_IDS: Born-locked. When set, this list is authoritative and
# claim mode is off. Empty = claim mode (first /start caller claims the bot).
ALLOWED_USER_IDS=

# LOCALE: working language for the bridge (en or ko). Set by mint via --lang.
LOCALE=en

# TZ: IANA timezone string (e.g. Asia/Seoul). When unused, OMIT the line
# entirely (an empty TZ= is not the same as an absent one); mint does the same.
# TZ=

# EXTRA_ALLOWED_ROOTS: os.pathsep-separated path-guard roots. Empty for the product.
EXTRA_ALLOWED_ROOTS=

# --- Bridge model whitelist (controls /model picker in Telegram) ---
# Set by installer from subscription tier. fable,opus,sonnet,haiku on every tier (DGN-346/DGN-813: fable is listed, not defaulted).
# Override here if you want a different set after install.
BRIDGE_MODELS=fable,opus,sonnet,haiku

# --- Session / timeout knobs (bridge config.py) ---
# CLAUDE_PROCESS_TIMEOUT: per-turn timeout in seconds (code default 600).
CLAUDE_PROCESS_TIMEOUT=1200
# CLAUDE_TIMEOUT_STOP_GRACE: seconds between the soft stop (when the turn is
# asked to wrap up) and the hard teardown. Code default 20. Seeded because
# bridge/config.py:407 READS it -- an unseeded key a newborn cannot inherit
# is what the DGN-1221 seed/live gate blocks on, and it blocked here.
CLAUDE_TIMEOUT_STOP_GRACE=20
# CLAUDE_AUTO_RESUME: 1 = silently auto-continue the turn when it hits the
# per-turn timeout. The code default is 0, but every live instance runs 1
# (DGN-1523: born with 0, the agent cannot continue itself and the owner is
# told to press a button that does not exist). Keep 1 unless you have a
# specific reason to disable self-continuation.
CLAUDE_AUTO_RESUME=1
# CLAUDE_AUTO_RESUME_MAX: max silent auto-resume retries per turn (code
# default 2; raise per instance for long-turn workloads).
CLAUDE_AUTO_RESUME_MAX=2

# --- Streaming ---
# DRAFT_UPDATE_INTERVAL: seconds between draft-message edits (code default 1.0).
DRAFT_UPDATE_INTERVAL=1.0

# --- Logging ---
# File-log level for the bridge (code default INFO).
LOG_LEVEL=INFO

# --- Bridge guards (DGN-376). Default ON; set 0 only as a deliberate
# per-instance exception (e.g. a dev channel that legitimately quotes the
# guarded scaffold strings). ---
BRIDGE_REGISTER_GUARD=1
BRIDGE_SCAFFOLD_GUARD=1

# --- Voice input (faster-whisper). Model chosen during install. ---
# "small" is also the config.py default.
LOCAL_WHISPER_MODEL=small

# --- Interim progress narration (DGN-930) ---
# INTERIM_AGENT_CLASS picks the UNSET default streaming behavior by agent kind
# (only consulted when INTERIM_MODE below is unset):
#   nondev (default) -> inline: every interim block streams live, never folded.
#                       Non-dev / domain agents (coaching, life-assistant) keep
#                       live progress visible instead of collapsing it.
#   dev              -> fold (live-then-fold): interim streams live as a growing
#                       progress bubble, then collapses to a caption + expandable
#                       quote at turn end while the final answer arrives as its
#                       own message. Dev agents (Metal/Skull) keep the record.
# INTERIM_AGENT_CLASS=nondev
#
# INTERIM_MODE overrides the class default entirely: suppress | inline | fold.
# Empty behaves as unset (config.py normalizes it) and takes the
# INTERIM_AGENT_CLASS default above.
INTERIM_MODE=

# --- Remote version check (session-start hook) ---
# Default ON. At session start the agent fetches the VERSION file from the public repo
# over HTTPS (2-second timeout, fail-silent, throttled to at most once per 6 hours).
# Sends ONLY a GET to raw.githubusercontent.com/coolcoolk/dogany-agent/main/VERSION.
# No user data, no auth token, no instance metadata is sent -- server sees only your IP,
# the same as a git clone. Never blocks a session.
# To opt out, uncomment and set to 0:
# DOGANY_VERSION_CHECK=0

# --- Email (dogany-mailer service) ---
# Email sends via your connected Google account (gws gmail; one OAuth login
# covering calendar + tasks + gmail.send, connected in agent onboarding).
# No app password, no SMTP. Ask the agent to "connect Google" to enable sending.
# Both keys are the OWNER's to fill; blank is a valid state (mailer skips them).
# EMAIL_ADDRESS: optional From hint (e.g. you@gmail.com).
EMAIL_ADDRESS=
# EMAIL_CC: your address, auto-CC'd on every send.
EMAIL_CC=
