{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "model": "sonnet",
  "autoMemoryEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/statusline.py"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/skill-update-track.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill|Workflow|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/usage-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ONBOARDING_FILE=__PROJECT_ROOT__ WRITE_PATHS_D4_MODE=detect /usr/bin/python3 __PROJECT_ROOT__/routines/write-paths-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "BASH_GATE_MODE=detect /usr/bin/python3 __PROJECT_ROOT__/routines/bash-safety-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/done-claim-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/durable-write-pointer.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Agent|Task|Skill|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/dispatch-return-result-first-gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/card-followup.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/skill-feedback-gate.py --record",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/subagent-stop-record.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|Workflow|TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/bg-job-notice.py --launched",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/fable-death-catch.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ONBOARDING_FILE=__PROJECT_ROOT__ /usr/bin/python3 __PROJECT_ROOT__/routines/onboarding-gate-stop.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/ticket-status-enum-lint.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/text-layer-pointer.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/session-recap.py"
          },
          {
            "type": "command",
            "command": "ONBOARDING_FILE=__PROJECT_ROOT__ /usr/bin/python3 __PROJECT_ROOT__/routines/onboarding-check.py"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/version-check.py"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/bridge-stale-check.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/loader-manifest.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/terms.py block",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/skill-update-track.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "ONBOARDING_FILE=__PROJECT_ROOT__ /usr/bin/python3 __PROJECT_ROOT__/routines/onboarding-gate-stop.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/memory-engine/memory.py hook",
            "timeout": 12
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/why-net.py ups",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/decision-ledger.py ups",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/text-layer-pointer.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/status-footer.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 __PROJECT_ROOT__/routines/turn-frame.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
