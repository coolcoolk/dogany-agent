# Bridge configuration template. Copy to PROJECT_ROOT/.telegram_bot/.env and fill in.
# The project .env wins; this package-level .env is a fallback for shared values
# (e.g. CLAUDE_CLI_PATH). Do NOT commit real tokens.

# --- Required ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Access control (comma-separated Telegram user IDs) ---
# Born-locked: when set, this list is authoritative and claim mode is off.
# Empty = claim mode (first /start caller claims the bot).
ALLOWED_USER_IDS=

# --- Localization (user-facing strings: ko or en; default en) ---
# LOCALE=en

# --- Claude CLI (optional; defaults to PATH lookup) ---
# CLAUDE_CLI_PATH=/opt/homebrew/bin/claude

# --- Session / timeout knobs ---
# AUTO_NEW_SESSION_AFTER_HOURS=24        # 0/false/off disables
# CLAUDE_PROCESS_TIMEOUT=600             # per-turn timeout in seconds
# CLAUDE_AUTO_RESUME=0                   # 1 to silently auto-continue on timeout
# CLAUDE_AUTO_RESUME_MAX=2               # max silent auto-resume retries
# CLAUDE_MAX_BUFFER_SIZE=16777216        # SDK subprocess JSON read buffer, bytes (default 16MB; SDK default is 1MB)

# --- Streaming ---
# DRAFT_UPDATE_MIN_CHARS=30
# DRAFT_UPDATE_INTERVAL=1.0

# --- Voice input (local faster-whisper only; input only, no TTS) ---
# TRANSCRIPTION_PROVIDER=local
# LOCAL_WHISPER_MODEL=small
# WHISPER_LANGUAGE=ko                    # auto/empty = auto-detect
# VOICE_REPLY_ENABLED=false
# MAX_VOICE_DURATION=300
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# --- Email (dogany-mailer service) ---
# Email sends via your connected Google account (gws gmail; one OAuth login
# covering calendar + tasks + gmail.send, connected in agent onboarding).
# No app password, no SMTP. Ask the agent to "connect Google" to enable sending.
# EMAIL_ADDRESS=            # optional From hint (e.g. you@gmail.com)
# EMAIL_CC=                 # your address, auto-CC'd on every send

# --- Fast-path interceptor (DGN-801; per-instance, DEFAULT OFF) ---
# When FASTPATH_HANDLER names an executable, a short numeric-looking message on
# an active session is offered to that domain-owned handler BEFORE an SDK model
# turn spawns; a handler that fully processes it (exit 0, rendered body on
# stdout) has its result pushed and the model turn suppressed. The bridge is
# domain-agnostic: it only knows this path + the exit0/exit2 contract.
#   - UNSET / empty / missing / non-executable => interceptor fully inert
#     (every message takes the normal SDK path; agents without a handler are
#     untouched). This is the default -- leave the line commented to stay OFF.
#   - Relative paths resolve against PROJECT_ROOT; absolute paths allowed.
# Env key FASTPATH_HANDLER -> code constant config.FASTPATH_HANDLER.
# FASTPATH_HANDLER=files/program/session-fastpath
#
# Upper bound for one handler invocation (spawn -> rendered stdout), seconds.
# On expiry the handler's WHOLE process group is killed (SIGTERM -> grace ->
# SIGKILL) so no child orphans. Default 3.0 when unset.
# Env key FASTPATH_TIMEOUT -> code constant config.FASTPATH_TIMEOUT_S.
# FASTPATH_TIMEOUT=3.0

# --- Path guard extra roots ---
# Extra absolute roots (os.pathsep-separated) the path guard treats as inside PROJECT_ROOT; leave empty for strict default.
EXTRA_ALLOWED_ROOTS=

# --- Logging ---
# LOG_LEVEL=INFO
